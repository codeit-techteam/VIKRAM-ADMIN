# Production defaults baked in at `next build` (Vercel).
# Browser calls stay same-origin; next.config.ts rewrites to DigitalOcean.
NEXT_PUBLIC_APP_NAME=Bajriwala Admin Panel
NEXT_PUBLIC_APP_URL=https://vikram-admin.vercel.app
NEXT_PUBLIC_API_BASE_URL=/backend-api/v1
API_PROXY_TARGET=https://bajriwala-backend-zkuxd.ondigitalocean.app
NEXT_PUBLIC_AUTH_TOKEN_KEY=bw_access_token
NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=bw_refresh_token
