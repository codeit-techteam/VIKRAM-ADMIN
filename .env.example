# App
NEXT_PUBLIC_APP_NAME=Bajriwala Admin Panel
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Browser API base (same-origin proxy — see next.config.ts rewrites)
NEXT_PUBLIC_API_BASE_URL=/backend-api/v1

# Server-side upstream for Next.js rewrites.
# Use DigitalOcean so local Admin stays in sync with Vercel / production data.
API_PROXY_TARGET=https://bajriwala-backend-zkuxd.ondigitalocean.app

# Only point at local backend when developing unreleased API routes
# AND your local DB is seeded/synced with production data:
# API_PROXY_TARGET=http://localhost:8000

# Direct API URL (avoid in the browser — DigitalOcean CORS will block Vercel)
# NEXT_PUBLIC_API_BASE_URL=https://bajriwala-backend-zkuxd.ondigitalocean.app/api/v1

# Auth
NEXT_PUBLIC_AUTH_TOKEN_KEY=bw_access_token
NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=bw_refresh_token

# --- Vercel production (vikram-admin.vercel.app) ---
# Set these in Vercel → Project → Settings → Environment Variables:
# NEXT_PUBLIC_APP_URL=https://vikram-admin.vercel.app
# NEXT_PUBLIC_API_BASE_URL=/backend-api/v1
# API_PROXY_TARGET=https://bajriwala-backend-zkuxd.ondigitalocean.app
# NEXT_PUBLIC_AUTH_TOKEN_KEY=bw_access_token
# NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=bw_refresh_token
